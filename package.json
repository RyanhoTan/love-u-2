{
  "name": "love-u-2",
  "private": true,
  "version": "0.1.0",
  "packageManager": "pnpm@10.11.0",
  "scripts": {
    "dev": "node ./scripts/dev.mjs && adb reverse tcp:8081 tcp:8081",
    "dev:app": "pnpm --dir app dev",
    "dev:server": "pnpm --dir server dev",
    "clean": "node ./scripts/clean.mjs",
    "install:all": "pnpm --dir app install && pnpm --dir server install",
    "format": "prettier --write ./app/app ./app/components ./scripts"
  },
  "dependencies": {
    "react-native-safe-area-context": "^5.7.0"
  },
  "devDependencies": {
    "eslint": "^10.4.1",
    "eslint-plugin-react-native": "^5.0.0",
    "prettier": "3.8.3"
  }
}
